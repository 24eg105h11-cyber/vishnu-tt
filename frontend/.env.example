# ===================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and adjust values if needed
# ===================================================

# Development Server Port
VITE_PORT=5173

# Backend Server Base URL
VITE_BACKEND_URL=http://localhost:8080

# API Base URL (Relative path '/api' or full URL 'http://localhost:8080/api')
VITE_API_BASE_URL=/api

# WebSocket Endpoint URL
VITE_WS_URL=ws://localhost:8080/ws

# Application Details
VITE_APP_TITLE=Campus Event Management Platform
VITE_APP_VERSION=1.0.0

# Mock Data Fallback Enable/Disable
VITE_ENABLE_MOCK_FALLBACK=true
